{
  "$schema": "https://opencode.ai/config.json",
  "username": "moldy-user",
  "default_agent": "build",
  "logLevel": "INFO",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,
  "instructions": ["AGENTS.md", "docs/AI_WORKFLOW.md"],
  "skills": {
    "paths": [".agents/skills"]
  },
  "agent": {
    "build": {
      "description": "Build and development agent for moldy project",
      "mode": "primary"
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "git *": "allow",
      "*": "ask"
    },
    "external_directory": {
      "*": "allow"
    }
  },
  "formatter": false,
  "lsp": false
}
